# ==============================================================================
# LogSherlock — environment template
# ==============================================================================
# Copy this file to .env and fill in what you need:
#
#     cp .env.example .env
#
# Three files share this one schema, so a key means the same thing in all of
# them and only the values differ:
#
#     .env         local execution      — loopback bindings, localhost services
#     .env.docker  container execution  — 0.0.0.0 bindings, compose aliases
#     .env.example this template        — git-tracked, never holds a secret
#
# EVERY KEY BELOW IS OPTIONAL. Each service applies the default shown here when
# a variable is absent *or empty*, so a fresh clone starts with no
# configuration at all. The values in this file are those defaults spelled out
# — copying it verbatim changes nothing about how the stack runs.
#
# Who reads what:
#     backend.py               loads this file, then backend/config.py reads API_*
#     init_db.py               loads this file, then reads DB_*
#     langgraph.json           loads this file via "env": ".env"
#     tests/mock_local_llm.py  loads this file, then reads MOCK_LLM_*
#     graph_library/*          reads the environment as it stands; no module in
#                              the library loads this file itself
#     frontend/vite.config.ts  loads this file (envDir points at this directory)
#
# Only VITE_-prefixed keys are exposed to the browser bundle
# (frontend/vite.config.ts sets envPrefix: 'VITE_'). Every provider key below
# stays server-side.
#
# ------------------------------------------------------------------------------
# WHICH FILE GETS LOADED
# ------------------------------------------------------------------------------
# Every service resolves this the same way, and every service prints the answer
# at startup with a [Config] prefix:
#
#     [Config] Sourced environment variables from .env (32 keys, selected by
#              default — no ENV_FILE override, not containerized)
#
# The rule, in priority order (graph_library/env_files.py, mirrored by
# frontend/vite.config.ts):
#
#     1. ENV_FILE=<path>   an explicit choice, honoured verbatim. A value that
#                          names nothing is reported as an error rather than
#                          quietly falling back, because silently substituting
#                          .env for a requested .env.docker would run a
#                          container against a developer's credentials.
#     2. .env.docker       when a container indicator is present
#                          (/.dockerenv, or DOCKER_CONTAINER /
#                          KUBERNETES_SERVICE_HOST / container set) and the
#                          file exists.
#     3. .env              the local default.
#     4. nothing           the environment is used exactly as supplied, which
#                          is the normal case when an orchestrator or a secrets
#                          manager provides it.
#
# ENV_FILE is deliberately NOT a key in this file. It selects which file to
# read, so a value written inside one could only be read after the decision it
# was meant to inform had already been made. Set it in the shell, in a compose
# `environment:` block, or on the command line:
#
#     ENV_FILE=.env.docker python3 backend.py
#     ENV_FILE=.env.docker npm run build

# ==============================================================================
# Backend API Settings
# ==============================================================================
# Read by backend/config.py -> ApiSettings.from_env(), applied by backend.py.

# Bind address. Loopback on purpose: this process holds a database credential
# and your LLM keys. Set 0.0.0.0 deliberately — see .env.docker.
API_HOST=127.0.0.1

# Bind port. 8010 rather than 8000, which the local-LLM path already owns.
API_PORT=8010

# Comma-separated browser origins allowed to call the API. Explicit rather than
# "*", because a wildcard is incompatible with allow_credentials=True.
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Seconds an idle connection is held open between requests. This is the
# keep-alive budget, not a request deadline — uvicorn puts no ceiling on how
# long a handler may run.
API_KEEP_ALIVE_TIMEOUT=300

# Seconds one graph invocation may run before the request is failed with a 504.
# 0 disables the deadline.
API_GRAPH_TIMEOUT=900

# uvicorn log level: critical | error | warning | info | debug | trace
API_LOG_LEVEL=info

# Auto-reload on file change. Development only — it discards the compiled graph
# on every edit.
API_RELOAD=false

# ==============================================================================
# Mock LLM Server Settings
# ==============================================================================
# Read by tests/mock_local_llm.py when it is run as a standalone server:
#
#     python3 tests/mock_local_llm.py
#
# It answers all four structured-output schemas offline, so the whole pipeline
# runs with no provider key and no network. Keep these in step with
# LOCAL_LLM_BASE_URL below — the mock serves the port that URL points at, and a
# mismatch surfaces only as "Connection refused" from every LLM node, with
# nothing at all in the mock's terminal.

MOCK_LLM_HOST=127.0.0.1
MOCK_LLM_PORT=8000

# ==============================================================================
# Database Settings (PostgreSQL)
# ==============================================================================
# Read by graph_library/write_to_db/config.py -> DatabaseConfig.from_env(), and
# shared verbatim with the write_to_db node, init_db.py and the API's read path
# — so the three cannot drift onto different databases.
#
# Run `python3 init_db.py` once before the first investigation. NOTE that it
# TRUNCATES the investigations table if it already exists.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres

# No default. An empty password is *omitted* from the connection parameters
# rather than sent as "", because the two are not the same to libpq and a blank
# one is rejected by a trust-authenticated server.
DB_PASSWORD=

# Seconds to wait for a connection. Short on purpose: the write happens at the
# end of a graph run, so an unreachable database must degrade in seconds rather
# than hang a run that has already produced its whole report.
DB_CONNECT_TIMEOUT=5

# ==============================================================================
# Redis Cache Settings
# ==============================================================================
# RESERVED — no module in this repository reads these keys yet. They are part
# of the shared schema so .env, .env.docker and this template stay aligned, and
# so a cache can be introduced without a second round of environment plumbing.
# Setting them today has no effect on any service.

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ==============================================================================
# LLM Provider & Local Server Settings
# ==============================================================================
# Read by graph_library/error_analysis/llm_factory.py, which all three LLM
# nodes share. Credentials come from the environment and never from graph
# state, so a key cannot leak into a report, a checkpoint or a trace.
#
# Provider SDKs are imported lazily: install only the extra you actually call
# (pip install -e ".[openai]" / ".[anthropic]" / ".[gemini]").

# Cloud provider keys. Leave blank for any vendor you do not call.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# The "local" provider — any OpenAI-compatible server (vLLM, Ollama, LM Studio,
# or tests/mock_local_llm.py). This must name the same host:port the mock is
# started on above, with the /v1 suffix the OpenAI wire protocol expects.
LOCAL_LLM_BASE_URL=http://127.0.0.1:8000/v1

# The model id the local server serves. The mock ignores it; a real server does
# not.
LOCAL_LLM_MODEL_NAME=llama-3.3-70b-instruct

# Local servers usually ignore the key, but the OpenAI client refuses to send an
# empty one — hence a non-empty placeholder rather than "".
LOCAL_LLM_API_KEY=cant-be-empty

# Optional web-search detour for the error-analysis node, off by default. Read
# by graph_library/web_search/client.py. Leave blank unless you set
# enable_web_search on a run.
TAVILY_API_KEY=

# ==============================================================================
# Frontend Settings (Vite)
# ==============================================================================
# The ONLY keys that reach the browser. Vite is configured with
# envPrefix: 'VITE_', so nothing above this line is bundled.

# Where the React client sends its requests. The /api prefix is appended
# automatically when it is absent, so the backend *origin* is what belongs
# here. Leave blank to fall back to the relative path /api, which routes
# through the Vite dev proxy in development and through a single reverse proxy
# in production.
VITE_API_BASE_URL=http://127.0.0.1:8010

# ==============================================================================
# LangSmith Tracing (optional)
# ==============================================================================
# Tracing is configured entirely through the environment; no module in
# graph_library/ reads or sets these.
#
# NOTE on large payloads: raw_logs and parsed_logs both live in graph state, so
# a multi-megabyte corpus pushes a single trace upload past LangSmith's limits
# and fails on a background thread — costing observability, not results. Use
# LANGSMITH_TRACING=false for full-corpus runs.

LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=
LANGSMITH_ENDPOINT=
